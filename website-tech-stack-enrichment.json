        },
        "options": {}
      },
      "id": "40d083c9-c56d-4cb7-a1c6-f32702e90b58",
      "name": "Read Domains",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        220,
        0
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const domains = [...new Set($input.all().map(i => String(i.json.domain || '').trim()).filter(Boolean))].slice(0, 100);\nreturn [{ json: { websites: domains } }];"
      },
      "id": "5432c77a-981f-4602-9a20-a01612625958",
      "name": "Collect Domains",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.apify.com/v2/acts/artificially~website-tech-stack-detector/run-sync-get-dataset-items",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ websites: $json.websites, maxPagesPerDomain: 2 }) }}",
        "options": {
          "timeout": 300000
        }
      },
      "id": "1368ca91-0cf6-4c05-af51-f44544213208",
      "name": "Tech Stack Detector",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Apify API token"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const join = v => Array.isArray(v) ? v.join(', ') : (v ?? '');\nreturn $input.all().map(({ json: j }) => {\n  const h = j.highlights || {};\n  return { json: {\n    domain: j.input || j.domain,\n    title: j.title,\n    cms: join(h.cms),\n    ecommerce: join(h.ecommerce),\n    analytics: join(h.analytics),\n    advertising: join(h.advertising),\n    crm: join(h.crm),\n    emailProvider: join(h.emailProvider),\n    payment: join(h.payment),\n    hosting: join(h.hosting),\n    cdn: join(h.cdn),\n    allTechnologies: (j.technologies || []).map(t => t.name).join(', '),\n    checkedAt: new Date().toISOString().slice(0, 10),\n  } };\n});"
      },
      "id": "0fba27c0-17ba-403f-bbbe-9dd79998e090",
